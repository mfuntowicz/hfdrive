<Project>
  <!--
    HF Drive central NuGet package versions (NuGet central package management).
    Every PackageReference in this repository MUST omit its Version attribute;
    exact versions are pinned here and enforced by RestoreLockedMode against the
    checked-in packages.lock.json files (see scripts/build.ps1).

    Pin rationale (all are current stable releases, verified on nuget.org):
      - CommunityToolkit.Mvvm 8.4.2 : latest stable MVVM toolkit (8.4.x line).
      - Microsoft.WindowsAppSDK 2.6.5 : approved WinUI 3 stack pin.
      - Microsoft.Windows.CsWin32 0.3.371 : approved native-binding generator pin.
      - Microsoft.NET.Test.Sdk 18.12.0 / xunit 2.9.3 / xunit.runner.visualstudio 4.0.1 :
        test stack for desktop/HfDrive.Protocol.Tests; runner 4.0.1 declares support
        for xUnit.net 1.9.2+ (covers 2.9.3).
    Microsoft.Windows.SDK.NET.Ref is NOT pinned here: its version is controlled by
    <WindowsSdkPackageVersion> in desktop/HfDrive.Desktop/HfDrive.Desktop.csproj
    (10.0.26100.87), which stays inside the .NET 11 SDK managed 26100 target map.
  -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
