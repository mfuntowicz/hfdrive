<Window
    x:Class="HfDrive.Desktop.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HfDrive.Desktop"
    xmlns:vm="using:HfDrive.Desktop.ViewModels"
    Title="HF Drive">

    <!--
      OneDrive-style tray panel. Every value is observed provider data from the
      shared ProviderSession (TrayViewModel); nothing here is simulated. The
      panel shows explicit loading, disconnected, setup, unavailable, empty and
      failed states rather than implying success. The VibingHuggy celebration
      appears only when the tray view model proves every configured connection
      is genuinely up to date (TrayViewModel.IsAllSynced).
    -->
    <!-- The popup fills its native client area. PlacePanel clamps the preferred
         400x620-DIP viewport to the monitor work area; full-height tab cards
         scroll independently without clipping the header or footer. -->
    <Grid x:Name="RootPanel"
          AutomationProperties.AutomationId="HfDriveTrayPanel"
          AutomationProperties.Name="HF Drive tray panel"
          Background="{ThemeResource HfPageBackgroundBrush}">

        <!-- Panel-local resources on the root grid element (the app's
             element-scoped WinUI convention), resolved by the children below. -->
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="TrayCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HfCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HfCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="TraySectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header: left account avatar, centered title, refresh/close ── -->
        <Grid Grid.Row="0"
              Padding="16,12"
              Background="{ThemeResource HfHeaderBackgroundBrush}"
              BorderBrush="{ThemeResource HfCardBorderBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The logged user's picture occupies the left identity slot.
                 CatchingHuggy remains the loading/missing/failed-image fallback. -->
            <Grid Grid.Column="0"
                  Width="32" Height="32"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{x:Bind ViewModel.AvatarAutomationName, Mode=OneWay}">
                <Ellipse x:Name="TrayAvatarFallbackShape"
                         Width="32" Height="32">
                    <Ellipse.Fill>
                        <ImageBrush Stretch="UniformToFill">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="ms-appx:///Assets/CatchingHuggy.png" DecodePixelWidth="64" />
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="TrayAvatarShape"
                         Width="32" Height="32"
                         Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="TrayAvatarBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- Center across the full header; the side slots do not offset it. -->
            <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="HF Drive"
                       FontFamily="Inter, Segoe UI"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource HfHeaderForegroundBrush}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button x:Name="TrayRefreshButton"
                        AutomationProperties.AutomationId="TrayRefresh"
                        AutomationProperties.Name="Refresh status"
                        ToolTipService.ToolTip="Refresh"
                        Click="OnRefreshClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="TrayCloseButton"
                        AutomationProperties.AutomationId="TrayClose"
                        AutomationProperties.Name="Close panel"
                        ToolTipService.ToolTip="Close"
                        Click="OnCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Body: explicit state surfaces + bounded, full-height live lists ── -->
        <Grid Grid.Row="1" Padding="16,12">

                <!-- Loading: no accepted status of the live session yet. -->
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsLoadingView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Loading account status…"
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                </StackPanel>

                <!-- Disconnected: the provider session is not connected. -->
                <StackPanel Spacing="8"
                            Visibility="{Binding IsDisconnectedView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource TraySectionHeaderStyle}" Text="Not connected" />
                    <TextBlock Text="{x:Bind ViewModel.DisconnectedText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                    <Button Content="Reconnect"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.ReconnectCommand}" />
                </StackPanel>

                <!-- First run: the accepted status reports zero connections. -->
                <StackPanel Spacing="8"
                            Visibility="{Binding IsNeedsSetupView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Image Width="120" Height="120"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           AutomationProperties.Name="HF Drive setup">
                        <Image.Source>
                            <BitmapImage UriSource="ms-appx:///Assets/SuperHuggy.png" DecodePixelWidth="240" />
                        </Image.Source>
                    </Image>
                    <TextBlock Text="No folders are connected yet. Set up HF Drive to sync your first folder."
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Opacity="0.8" />
                    <Button Content="Set up HF Drive"
                            HorizontalAlignment="Center"
                            Click="OnSetupClick" />
                </StackPanel>

                <!-- Unavailable: the live session cannot supply status. -->
                <StackPanel Spacing="8"
                            Visibility="{Binding IsUnavailableView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource TraySectionHeaderStyle}" Text="Status unavailable" />
                    <TextBlock Text="The provider status is unavailable right now. Open HF Drive to retry."
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                    <Button Content="Open HF Drive"
                            HorizontalAlignment="Left"
                            Click="OnOpenHFDriveClick" />
                </StackPanel>

                <!-- Configured account surface. Optional controls own their margins. -->
                <Grid Visibility="{Binding IsReadyView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Connection/service problems stay compact and above the tabs. -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="{ThemeResource HfCardBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasConnectionIssue, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="TrayConnectionIssue"
                            AutomationProperties.Name="Connection issue">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ConnectionIssueTitle, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionIssue.Detail, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind ViewModel.ConnectionIssue.ActionText, Mode=OneWay}"
                                    DataContext="{x:Bind ViewModel.ConnectionIssue, Mode=OneWay}"
                                    Click="OnIssueActionClick" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.WarningText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Margin="0,16"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasWarningText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Folder selector when more than one connection exists. -->
                    <StackPanel Grid.Row="2"
                                Spacing="4"
                                Margin="0,16"
                                AutomationProperties.AutomationId="TrayConnections"
                                AutomationProperties.Name="Synced folders"
                                Visibility="{Binding HasConnectionSelector, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Folder" Opacity="0.8" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedConnection, Mode=TwoWay}"
                                  DisplayMemberPath="TitleDisplay"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Activity and committed history share an explicit tab grid. -->
                    <Grid Grid.Row="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style x:Key="TrayTabButtonStyle" TargetType="RadioButton">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{ThemeResource HfHeaderForegroundBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="TabBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Center" />
                                            </Border>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CheckStates">
                                                    <VisualState x:Name="Checked">
                                                        <VisualState.Setters>
                                                            <Setter Target="TabBorder.Background" Value="{ThemeResource HfCardBackgroundBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <RadioButton Grid.Row="0" Grid.Column="0"
                                     GroupName="ActivityTabs"
                                     Style="{StaticResource TrayTabButtonStyle}"
                                     Content="Syncing now"
                                     IsChecked="{x:Bind ViewModel.IsSyncingTabSelected, Mode=TwoWay}"
                                     AutomationProperties.Name="Syncing now"
                                     />
                            <Border Grid.Row="1" Grid.ColumnSpan="2"
                                    VerticalAlignment="Stretch"
                                    Visibility="{Binding IsSyncingTabSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource TrayCardBorderStyle}"
                                    AutomationProperties.AutomationId="TrayActivity"
                                    AutomationProperties.Name="Syncing now">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.ActivityStateText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Opacity="0.8"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsActivityStatusVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.FileIssueItems, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="TrayFileIssues"
                                                  AutomationProperties.Name="File issues">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TrayIssueRow">
                                                <Border Margin="0,4,0,0"
                                                        Padding="8,6"
                                                        Background="{ThemeResource HfCardBackgroundBrush}"
                                                        BorderBrush="{ThemeResource HfCardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Detail, Mode=OneTime}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Opacity="0.8"
                                                                   TextWrapping="Wrap" />
                                                        <Button Content="{x:Bind ActionText, Mode=OneTime}"
                                                                HorizontalAlignment="Left"
                                                                Click="OnIssueActionClick" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Show more issues"
                                            HorizontalAlignment="Left"
                                            Command="{x:Bind ViewModel.LoadMoreIssuesCommand}"
                                            Visibility="{Binding HasMoreIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActivityItems, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TrayActivityRow">
                                                <Border Margin="0,4,0,0" Padding="8,6"
                                                        Background="{ThemeResource HfCardBackgroundBrush}"
                                                        CornerRadius="6">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind ItemName, Mode=OneTime}"
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind PhaseText, Mode=OneTime}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Opacity="0.8" />
                                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneTime}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Opacity="0.8" />
                                                        <TextBlock Text="{x:Bind ErrorText, Mode=OneTime}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Show more"
                                            HorizontalAlignment="Left"
                                            Command="{x:Bind ViewModel.LoadMoreActivityCommand}"
                                            Visibility="{Binding HasMoreActivity, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Grid AutomationProperties.AutomationId="AllSyncedAnimation"
                                          AutomationProperties.Name="Everything is up to date"
                                          Visibility="{Binding IsAllSynced, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="12"
                                                    MaxWidth="280">
                                            <Image x:Name="AllSyncedImage"
                                                   Width="96" Height="96"
                                                   Stretch="Uniform"
                                                   ImageOpened="OnAllSyncedImageOpened">
                                                <Image.Source>
                                                    <BitmapImage x:Name="AllSyncedAnimationSource"
                                                                 UriSource="ms-appx:///Assets/VibingHuggy.gif"
                                                                 DecodePixelWidth="256"
                                                                 AutoPlay="False" />
                                                </Image.Source>
                                            </Image>
                                            <TextBlock Text="{x:Bind ViewModel.AllSyncedText, Mode=OneWay}"
                                                       Style="{StaticResource TraySectionHeaderStyle}"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        <RadioButton Grid.Row="0" Grid.Column="1"
                                     GroupName="ActivityTabs"
                                     Style="{StaticResource TrayTabButtonStyle}"
                                     Content="Recent activity"
                                     IsChecked="{x:Bind ViewModel.IsHistoryTabSelected, Mode=TwoWay}"
                                     AutomationProperties.Name="Recent activity"
                                     />
                            <Border Grid.Row="1" Grid.ColumnSpan="2"
                                    VerticalAlignment="Stretch"
                                    Visibility="{Binding IsHistoryTabSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource TrayCardBorderStyle}"
                                    AutomationProperties.AutomationId="TrayHistory"
                                    AutomationProperties.Name="Recent activity">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Disabled"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.HistoryStateText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Opacity="0.8"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TrayHistoryRow">
                                                <Border Margin="0,4,0,0" Padding="8,6"
                                                        Background="{ThemeResource HfCardBackgroundBrush}"
                                                        CornerRadius="6">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind SummaryText, Mode=OneTime}"
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Opacity="0.8"
                                                                   TextWrapping="Wrap"
                                                                   Text="{x:Bind MetaText, Mode=OneTime}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Show older changes"
                                            HorizontalAlignment="Left"
                                            Command="{x:Bind ViewModel.LoadMoreHistoryCommand}"
                                            Visibility="{Binding HasMoreHistory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                    </Grid>

                    <!-- Provider capability gap for live activity (old provider). -->
                    <StackPanel Grid.Row="4"
                                Spacing="8"
                                Visibility="{Binding IsFeatureUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource TraySectionHeaderStyle}"
                                   Text="Provider update required"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FeatureUnavailableText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />
                    </StackPanel>
                </Grid>
        </Grid>

        <!-- ── Footer: equal three-column actions + spanning status row ─── -->
        <Grid Grid.Row="2"
              Padding="16,12"
              BorderBrush="{ThemeResource HfCardBorderBrush}"
              BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Three equal-width, equal-height action buttons at the
                 400-DIP panel width. The status line spans the row below so
                 its text can never misalign the buttons. -->
            <Button Grid.Row="0" Grid.Column="0"
                    x:Name="TrayPauseResumeButton"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}"
                    Content="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePauseResumeCommand}"
                    Visibility="{Binding IsReadyView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Row="0" Grid.Column="1"
                    x:Name="TrayAddBucketButton"
                    Margin="2,0"
                    Padding="0"
                    MinWidth="0"
                    MinHeight="32"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.Name="Add bucket"
                    Background="{ThemeResource HfAddBucketBackgroundBrush}"
                    ToolTipService.ToolTip="Add bucket"
                    Click="OnAddBucketClick">
                <FontIcon Glyph="&#xE710;"
                          FontSize="14"
                          Foreground="{ThemeResource HfAddBucketForegroundBrush}" />
            </Button>
            <Button Grid.Row="0" Grid.Column="2"
                    x:Name="TrayOpenButton"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.Name="Open HF Drive"
                    Content="Open HF Drive"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnOpenHFDriveClick" />

            <!-- Real pause/resume/last action status, own spanning row. -->
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                       Margin="0,6,0,0"
                       Text="{x:Bind ViewModel.LastActionText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.8"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
