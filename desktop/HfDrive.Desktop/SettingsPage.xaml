<Page
    x:Class="HfDrive.Desktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HfDrive.Desktop.ViewModels"
    xmlns:local="using:HfDrive.Desktop"
    Background="{ThemeResource HfPageBackgroundBrush}">

    <Page.Resources>
        <!-- The app's shared converter (same one TrayWindow.xaml uses); WinUI
             has no BooleanToVisibilityConverter in the presentation namespace. -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid RowSpacing="0">
        <!-- Responsive footer: one row of actions when there is room, a stacked
             column when the window is too narrow for side-by-side buttons. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FooterLayoutStates">
                <VisualState x:Name="WideFooter">
                    <VisualState.StateTriggers>
                        <!-- Side-by-side actions only where the content area is
                             guaranteed wide enough for all three buttons; at the
                             700–800px window widths the footer stacks instead, so
                             it can never clip horizontally. -->
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FooterActions.Orientation" Value="Horizontal" />
                        <Setter Target="FooterActions.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowFooter">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FooterActions.Orientation" Value="Vertical" />
                        <Setter Target="FooterActions.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Body: scrolls; the footer below stays visible. -->
        <ScrollViewer Grid.Row="0" Padding="24,16,24,8">
            <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{ThemeResource HfHeaderForegroundBrush}" />
                    <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                               Text="Control how fast HF Drive transfers data and how much memory and disk space it uses on this PC. Leave a field empty to keep its current value; changes take effect when you save." />
                    <TextBlock Text="{x:Bind ViewModel.SettingsNotReadyText, Mode=OneWay}"
                               Style="{StaticResource HfSettingsDescriptionStyle}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{x:Bind ViewModel.HasSettingsNotReadyText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Width="20" Height="20"
                                      AutomationProperties.Name="A settings read or save is running" />
                        <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                                   Style="{StaticResource HfSettingsDescriptionStyle}" />
                    </StackPanel>

                    <!-- Session and revision are technical detail: present but
                         out of the way of the everyday form. -->
                    <Expander HorizontalAlignment="Stretch"
                              IsExpanded="False"
                              Header="Technical details">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.SessionStateText, Mode=OneWay}"
                                       Style="{StaticResource HfSettingsDescriptionStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SettingsRevisionText, Mode=OneWay}"
                                       Style="{StaticResource HfSettingsDescriptionStyle}"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- Transfer speeds -->
                <Border Style="{StaticResource HfSettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Transfer speeds"
                                   Style="{StaticResource HfSettingsSectionTitleStyle}" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Speed limits for all of HF Drive's transfer work, across every connected folder. “Unlimited” (also written 0) means no limit." />

                        <TextBox Header="Upload speed"
                                 PlaceholderText="Unlimited, 10 MiB/s or bytes per second"
                                 IsEnabled="{x:Bind ViewModel.IsSettingsEditingEnabled, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SettingsUploadBpsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Upload speed" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="How fast HF Drive sends your changes to storage." />

                        <TextBox Header="Download speed"
                                 PlaceholderText="Unlimited, 10 MiB/s or bytes per second"
                                 IsEnabled="{x:Bind ViewModel.IsSettingsEditingEnabled, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SettingsDownloadBpsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Download speed" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="How fast HF Drive fetches the files you open." />

                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="{x:Bind ViewModel.SettingsRateExamplesText, Mode=OneTime}" />
                    </StackPanel>
                </Border>

                <!-- Local storage -->
                <Border Style="{StaticResource HfSettingsCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Local storage"
                                   Style="{StaticResource HfSettingsSectionTitleStyle}" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Four separate memory and disk budgets. The range cache only holds copies of data that is already saved; unsynchronized changes wait in staging until they are published." />

                        <TextBox Header="Transfer memory"
                                 PlaceholderText="512 MiB"
                                 IsEnabled="{x:Bind ViewModel.IsSettingsEditingEnabled, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SettingsTransferMemoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Transfer memory" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Memory HF Drive may use to buffer transfers while data moves." />

                        <TextBox Header="Range cache size"
                                 PlaceholderText="512 MiB"
                                 IsEnabled="{x:Bind ViewModel.IsSettingsEditingEnabled, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SettingsRangeCacheText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Range cache size" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Disk space for downloaded file pieces kept so reopening files is fast. The cache only holds copies of data already saved on this PC or in your drive — it never holds unsynchronized changes, so shrinking it loses no work." />

                        <TextBox Header="Staging limit"
                                 PlaceholderText="10 GiB"
                                 IsEnabled="{x:Bind ViewModel.IsSettingsEditingEnabled, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SettingsStagingAdmissionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Staging limit" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Disk space for snapshots of local changes waiting to upload. This is a ceiling for starting new snapshots: HF Drive never deletes unsynchronized snapshots or conflict copies to stay under it." />

                        <TextBox Header="Free space reserve"
                                 PlaceholderText="1 GiB"
                                 IsEnabled="{x:Bind ViewModel.IsSettingsEditingEnabled, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SettingsMinimumFreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Free space reserve" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Free disk space HF Drive keeps available on the volume; new work pauses instead of filling the disk." />

                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="{x:Bind ViewModel.SettingsSizeExamplesText, Mode=OneTime}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Fixed footer: status and actions stay reachable while the body scrolls. -->
        <Border Grid.Row="1"
                Background="{ThemeResource HfHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource HfCardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status: only what the user needs now; technical detail lives
                     in the header expander. Empty lines take no space. -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.SettingsDirtyText, Mode=OneWay}"
                               Style="{StaticResource HfSettingsDescriptionStyle}"
                               Visibility="{x:Bind ViewModel.IsSettingsDirty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{x:Bind ViewModel.SettingsResultText, Mode=OneWay}"
                               Style="{StaticResource HfSettingsDescriptionStyle}"
                               Visibility="{x:Bind ViewModel.HasSettingsResultText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.SettingsErrorText, Mode=OneWay}"
                               Style="{StaticResource HfSettingsDescriptionStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind ViewModel.HasSettingsErrorText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               IsTextSelectionEnabled="True" />
                </StackPanel>

                <!-- Actions: side-by-side at wide widths, stacked when the window is
                     too narrow (see the FooterLayoutStates visual states above) so the
                     row never clips horizontally. -->
                <StackPanel x:Name="FooterActions"
                            Grid.Row="1"
                            Spacing="8">
                    <FontIcon Glyph="&#xE73E;"
                              FontSize="16"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource HfStorageAccentForegroundBrush}"
                              Visibility="{x:Bind ViewModel.SettingsHasSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="The last save succeeded" />
                    <Button Content="Reload settings"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ReloadSettingsCommand}" />
                    <Button Content="Discard my changes"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsSettingsDirty, Mode=OneWay}"
                            Click="OnDiscardChangesClick" />
                    <Button Content="Save settings"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ApplySettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
