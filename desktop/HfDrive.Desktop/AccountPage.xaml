<Page
    x:Class="HfDrive.Desktop.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HfDrive.Desktop.ViewModels">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Account" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="AccountStateText"
                       TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.AccountStateText, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Sign in with browser" Command="{x:Bind ViewModel.SignInCommand}" />
                <Button Content="Use device code" Command="{x:Bind ViewModel.DeviceLoginCommand}" />
                <Button Content="Cancel sign-in" Command="{x:Bind ViewModel.CancelLoginCommand}" />
                <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoginPending, Mode=OneWay}" Width="24" Height="24" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.LoginInstructions, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="Sign-out disables native and supplemental storage access without deleting local work." TextWrapping="Wrap" />

            <TextBlock Text="Verified owner identities" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock Text="Membership and role labels are not proof of bucket write access." TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.OwnersEmptyText, Mode=OneWay}" TextWrapping="Wrap" />
            <ListView ItemsSource="{x:Bind ViewModel.Owners, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OwnerViewModel">
                        <StackPanel Spacing="2" Margin="0,0,0,8">
                            <TextBlock Text="{x:Bind HeaderDisplay, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind NamespaceText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Text="{x:Bind RoleText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind RestrictionsText}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind CapabilityText, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Load more owners" Command="{x:Bind ViewModel.LoadMoreOwnersCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsOwnersLoading, Mode=OneWay}" Width="24" Height="24" />
            </StackPanel>

            <TextBlock Text="Provider connection" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock x:Name="ConnectionStateText"
                       TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.ConnectionStateText, Mode=OneWay}" />
            <TextBlock x:Name="ConnectionDetailText"
                       TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.ConnectionDetailText, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.PeerVerificationText, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.ProviderVersionText, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.ProviderFeaturesText, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.PipeNameDisplay, Mode=OneTime}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="12" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Connect to provider"
                        Command="{x:Bind ViewModel.ConnectCommand}"
                        IsEnabled="{x:Bind ViewModel.IsDisconnected, Mode=OneWay}" />
                <Button Content="Refresh status"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
