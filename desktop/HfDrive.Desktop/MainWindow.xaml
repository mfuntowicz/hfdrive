<Window
    x:Class="HfDrive.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HF Drive">

    <!--
      Lifecycle shell. The window starts in the compact onboarding layout (the
      shared SetupPage, no navigation pane) while authenticating/loading state,
      and switches to the full navigation shell only when an accepted provider
      status shows a configured connection or the user finishes setup. The
      content host receives either the single page frame (compact) or the
      navigation shell (configured) from code-behind.

      Chrome: the window always owns its caption (ExtendsContentIntoTitleBar),
      so no separate white title strip ever paints. The compact setup flow
      shows exactly one accessible close control on the existing
      AppWindow.Closing close-to-tray path; the configured shell shows the
      branded CatchingHuggy caption below. Both caption rows are registered as
      the OS caption drag region through InputNonClientPointerSource, so the
      OS moves the window (no screen-coordinate drag loop). The shared
      WindowChrome DWM opt-in keeps rounded corners and shadow in both modes;
      the configured shell keeps the native resize frame and min/max/close
      window controls in the caption's right inset.
    -->
    <Grid x:Name="RootLayout">
        <!-- Only the Mica-owning window makes its shell transparent. Application
             resources stay opaque for the tray, which has no SystemBackdrop. -->
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="HfPageBackgroundBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="HfHeaderBackgroundBrush" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="HfPageBackgroundBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="HfHeaderBackgroundBrush" Color="Transparent" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Normal-shell branded caption (extends into the native caption area;
          the system caption buttons draw in the right inset reserved by
          code-behind). The brand text area is the OS caption drag region;
          the logo stays plain client content. Hidden while compact.
        -->
        <Grid x:Name="ShellCaptionBar"
              Grid.Row="0"
              Height="40"
              Visibility="Collapsed"
              Background="{ThemeResource HfHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Width="24" Height="22"
                   Stretch="Uniform"
                   Margin="12,0,6,0"
                   AutomationProperties.Name="HF Drive">
                <Image.Source>
                    <BitmapImage UriSource="ms-appx:///Assets/CatchingHuggy.png" DecodePixelWidth="48" />
                </Image.Source>
            </Image>
            <!-- Draggable brand area (never interactive controls). -->
            <Grid x:Name="ShellDragHeader"
                  Grid.Column="1"
                  Background="{ThemeResource HfHeaderBackgroundBrush}"
                  AutomationProperties.AutomationId="ShellDragHeader"
                  AutomationProperties.Name="HF Drive title bar">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Spacing="0">
                    <TextBlock Text="HF Drive"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource HfHeaderForegroundBrush}" />
                    <TextBlock Text="Hugging Face Storage on your PC"
                               FontSize="11"
                               Opacity="0.8"
                               Foreground="{ThemeResource HfHeaderForegroundBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--
          Compact-only replacement for the system caption strip. The drag
          header spans the top of the client area and is registered with
          InputNonClientPointerSource as the window's Caption drag region
          (client-relative physical pixels, recomputed on size/scale change);
          the close button sits outside that region so it stays interactive.
          No screen-coordinate drag loop: the OS moves the window.
        -->
        <Grid x:Name="SetupCaptionBar"
              Grid.Row="1"
              Height="40"
              Visibility="Collapsed"
              Background="{ThemeResource HfHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Draggable blank caption area (never the close button). -->
            <Grid x:Name="SetupDragHeader"
                  Grid.Column="0"
                  Background="{ThemeResource HfHeaderBackgroundBrush}"
                  AutomationProperties.AutomationId="SetupDragHeader"
                  AutomationProperties.Name="Setup title bar" />
            <!-- The single custom close control; outside the drag region so it
                 keeps hover/press/click/keyboard input. Min size is cleared so
                 it renders as a caption-sized button. -->
            <Button x:Name="SetupCloseButton"
                    Grid.Column="1"
                    Width="48"
                    Height="40"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="SetupClose"
                    AutomationProperties.Name="Close setup"
                    ToolTipService.ToolTip="Close"
                    Click="OnSetupCloseClick">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <!-- Visible retry surface for bounded provider startup failures. -->
        <Grid
            x:Name="StartupErrorBanner"
            Grid.Row="2"
            Visibility="Collapsed"
            Padding="12,8"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StartupErrorText"
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
            <Button
                x:Name="StartupRetryButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Retry"
                Click="OnStartupRetryClick" />
        </Grid>

        <!-- Compact-flow header: a way back to the normal shell once one exists. -->
        <Grid
            x:Name="CompactHeader"
            Grid.Row="3"
            Visibility="Collapsed"
            Padding="12,8,12,0">
            <Button
                x:Name="BackToShellButton"
                HorizontalAlignment="Left"
                Content="Back to HF Drive"
                Click="OnBackToShellClick" />
        </Grid>

        <Grid x:Name="ShellHost" Grid.Row="4" />
    </Grid>
</Window>
