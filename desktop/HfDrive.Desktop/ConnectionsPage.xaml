<Page
    x:Class="HfDrive.Desktop.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HfDrive.Desktop.ViewModels">

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Connections" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Every row below is an observed status record from the HF Drive provider. Nothing on this page is simulated."
                       TextWrapping="Wrap"
                       Opacity="0.8" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="EmptyText"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="{x:Bind ViewModel.ConnectionsEmptyText, Mode=OneWay}" />

        <ListView Grid.Row="2"
                  Margin="0,12,0,0"
                  ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConnectionViewModel">
                    <Border Padding="12" Margin="0,0,0,8" CornerRadius="4"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind TitleDisplay, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind SummaryDisplay, Mode=OneWay}" TextWrapping="Wrap" FontSize="18" />
                            <TextBlock Text="{x:Bind CountsText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind PendingBytesText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind PinText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind HydrationText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind RootPathDisplay, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                            <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
