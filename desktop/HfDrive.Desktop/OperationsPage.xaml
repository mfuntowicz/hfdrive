<Page
    x:Class="HfDrive.Desktop.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HfDrive.Desktop.ViewModels"
    xmlns:local="using:HfDrive.Desktop">

    <Page.Resources>
        <!-- The app's shared converter (same one SettingsPage.xaml uses); WinUI
             has no BooleanToVisibilityConverter in the presentation namespace. -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <!-- Advanced / activity and recovery surface. Cards, section titles,
         descriptions and primary buttons come from the shared keys the shell
         defines in App.xaml. Provider-wide settings are NOT on this page —
         SettingsPage owns that surface. Content stretches inside a ~900px
         column with 24px gutters; button rows use star-column grids or
         full-width rows so they reflow instead of clipping at narrow widths. -->
    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Heading -->
            <StackPanel Spacing="4">
                <TextBlock Text="Operations &amp; recovery"
                           Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                           Text="Manage sync controls, review conflicts and restore previous versions." />
            </StackPanel>

            <!-- Live session status -->
            <Border Style="{StaticResource HfSettingsCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Provider session"
                               Style="{StaticResource HfSettingsSectionTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SessionStateText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0"
                                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Width="24" Height="24"
                                      VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Connection controls -->
            <Border Style="{StaticResource HfSettingsCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Connection controls"
                                   Style="{StaticResource HfSettingsSectionTitleStyle}" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Scope each action to one connection, or leave the connection ID empty to pause or resume every connection at once. Connection, item and version IDs are the provider's UUIDs (8-4-4-4-12 hex)." />
                    </StackPanel>

                    <TextBox Header="Connection ID (UUID; leave empty for Pause/Resume to cover every connection)"
                             Text="{x:Bind ViewModel.ConnectionIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Optional item ID (subtree target for Pin/Unpin and Free Space)"
                             Text="{x:Bind ViewModel.ControlItemIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Sync state"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Pause stops new transfer and publication scheduling but keeps observation and queued work; resume revalidates access before dispatching again." />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Pause"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.PauseCommand}" />
                            <Button Grid.Column="1" Content="Resume"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ResumeCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Local content"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Pin requests the subtree be fully hydrated for offline use; unpin releases that request. The result reports how many files are actually hydrated." />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Pin"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.PinCommand}" />
                            <Button Grid.Column="1" Content="Unpin"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.UnpinCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Freeing local space dehydrates clean, committed, unpinned content in scope. Dirty, conflicting and pending files are never discarded silently." />
                        <Button Content="Free all local space"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.FreeAllCommand}" />
                        <Button Content="Free all except pinned"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.FreeExceptPinnedCommand}" />
                    </StackPanel>

                    <Expander HorizontalAlignment="Stretch"
                              IsExpanded="False"
                              Header="Selective-sync exclusions (advanced)">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                       Text="Complete item UUIDs to exclude from sync, comma-separated. Excluding clean content removes local placeholders through a journaled provider action and never publishes deletions; items holding unsynchronized work are retained and listed in the result." />
                            <TextBox Header="Selective-sync exclusions (complete item UUIDs, comma-separated)"
                                     Text="{x:Bind ViewModel.SelectiveSyncItemIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Apply selective sync"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ApplySelectiveSyncCommand}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{x:Bind ViewModel.ConnectionResultText, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionErrorText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>

            <!-- Remove connection: prepare → review → confirm. Nothing is
                 removed by preparing; confirmation always names the exact
                 reviewed preview and is disabled until it is current. -->
            <Border Style="{StaticResource HfSettingsCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Remove connection"
                                   Style="{StaticResource HfSettingsSectionTitleStyle}" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Scoped to the connection ID entered at the top of this page. Preparing shows exactly what a removal would do and never removes anything; confirmation names the reviewed preview so a changed connection can never be removed from a stale review." />
                    </StackPanel>

                    <ComboBox Header="Removal mode"
                              ItemsSource="{x:Bind ViewModel.UnlinkModes, Mode=OneTime}"
                              SelectedItem="{x:Bind ViewModel.SelectedUnlinkMode, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Removal mode">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnlinkModeChoice">
                                <TextBlock Text="{x:Bind Display, Mode=OneTime}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="Prepare removal preview"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.PrepareUnlinkCommand}" />

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.UnlinkPreviewVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.UnlinkResultText, Mode=OneWay}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{x:Bind ViewModel.UnlinkBlockingReasonsText, Mode=OneWay}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                        <TextBlock Text="{x:Bind ViewModel.UnlinkWarningText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind ViewModel.HasUnlinkWarning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="Files the reviewed preview is affected by (review before confirming):"
                                   Style="{StaticResource HfSettingsDescriptionStyle}" />
                        <ListView ItemsSource="{x:Bind ViewModel.UnlinkAffectedFiles, Mode=OneWay}"
                                  SelectionMode="None"
                                  MaxHeight="220"
                                  AutomationProperties.Name="Files affected by the removal preview">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:UnlinkFileRow">
                                    <TextBlock Text="{x:Bind Display, Mode=OneTime}"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               IsTextSelectionEnabled="True"
                                               Margin="0,2" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Explicit consent is requested only when the reviewed
                             preview discards unavailable bytes. -->
                        <CheckBox IsChecked="{x:Bind ViewModel.UnlinkConsent, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Visibility="{x:Bind ViewModel.UnlinkConsentVisibility, Mode=OneWay}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="I understand this removal permanently discards the unavailable bytes listed above on this device, and that they cannot be recovered without re-syncing from the remote content." />
                        </CheckBox>

                        <Button Content="Confirm removal"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ConfirmUnlinkCommand}" />

                        <TextBlock Text="{x:Bind ViewModel.UnlinkErrorText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Conflicts: visible by default — tray "Manage" lands here with a
                 preselected record, so the detail and resolutions must be
                 reachable without hunting. -->
            <Border Style="{StaticResource HfSettingsCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Conflicts"
                                   Style="{StaticResource HfSettingsSectionTitleStyle}" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Recorded conflicts from real provider state for the connection selected above. Opening this page from the tray's Manage action selects the exact record it pointed at; nothing is resolved until you choose a resolution here. No records are listed until you load them." />
                    </StackPanel>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Load conflicts"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadConflictsCommand}" />
                        <Button Grid.Column="1" Content="Load more"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadMoreConflictsCommand}" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.ConflictsResultText, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <ListView ItemsSource="{x:Bind ViewModel.Conflicts, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedConflict, Mode=TwoWay}"
                              SelectionMode="Single"
                              MaxHeight="260"
                              AutomationProperties.Name="Recorded conflicts">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConflictRow">
                                <TextBlock Text="{x:Bind Display, Mode=OneTime}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="Selected conflict"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedConflictDetailText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               IsTextSelectionEnabled="True" />

                    <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                               Text="Keep local publishes the local version, keep remote keeps the remote version (unsynchronized local bytes are preserved for recovery first), and keep both retains both under the recorded conflict name." />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Keep local"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ResolveKeepLocalCommand}" />
                        <Button Grid.Column="1" Content="Keep remote"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ResolveKeepRemoteCommand}" />
                        <Button Grid.Column="2" Content="Keep both"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.ResolveKeepBothCommand}" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.ConflictsErrorText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>

            <!-- History and restore -->
            <Border Style="{StaticResource HfSettingsCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="History &amp; restore"
                                   Style="{StaticResource HfSettingsSectionTitleStyle}" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Committed history for the connection selected at the top of this page, paged a bounded number of records at a time. Restoring an earlier version publishes it as a new committed operation — it never rewrites history or replaces stored objects. No records are listed until you load them." />
                    </StackPanel>

                    <TextBox Header="Optional subtree item ID (history filter)"
                             Text="{x:Bind ViewModel.HistoryItemIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Load history"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadHistoryCommand}" />
                        <Button Grid.Column="1" Content="Load more"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LoadMoreHistoryCommand}" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.HistoryResultText, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <ListView ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                              SelectionMode="None"
                              MaxHeight="320"
                              AutomationProperties.Name="Committed history records">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRow">
                                <TextBlock Text="{x:Bind Display, Mode=OneTime}"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           IsTextSelectionEnabled="True"
                                           Margin="0,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Expander HorizontalAlignment="Stretch"
                              IsExpanded="False"
                              Header="Restore an earlier version (advanced)">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                       Text="Enter the complete item and version UUIDs from a history record above. The restore is scoped to the connection selected at the top of this page." />
                            <TextBox Header="Item ID to restore (UUID)"
                                     Text="{x:Bind ViewModel.RestoreItemIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Version ID to restore (UUID)"
                                     Text="{x:Bind ViewModel.RestoreVersionIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Restore"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.RestoreCommand}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{x:Bind ViewModel.HistoryErrorText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource HfSettingsCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Diagnostics"
                                   Style="{StaticResource HfSettingsSectionTitleStyle}" />
                        <TextBlock Style="{StaticResource HfSettingsDescriptionStyle}"
                                   Text="Exports a redacted diagnostics archive (versions, health, counts and sanitized logs). User paths and names are replaced with stable per-export aliases; the archive never contains credentials, database files, snapshots or file contents. Uses the connection ID above when it is set; leave it empty for provider-wide diagnostics." />
                    </StackPanel>

                    <TextBox Header="Absolute destination path for the diagnostics ZIP"
                             Text="{x:Bind ViewModel.DiagnosticsPathText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Export diagnostics"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ExportDiagnosticsCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsResultText, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsErrorText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
