<Page
    x:Class="HfDrive.Desktop.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HfDrive.Desktop.ViewModels">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="Operations" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Every action below is a real provider RPC. Results and errors shown here come from the provider's typed responses; nothing is simulated."
                           TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock Text="{x:Bind ViewModel.SessionStateText, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
                    <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- Settings -->
            <StackPanel Spacing="8">
                <TextBlock Text="Settings (provider-wide)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Values are nonnegative integers. Upload/download are bytes per second (0 = unlimited). Leave a field empty to keep its stored value."
                           TextWrapping="Wrap" Opacity="0.8" />
                <TextBox Header="Upload bytes per second"
                         Text="{x:Bind ViewModel.SettingsUploadBpsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Download bytes per second"
                         Text="{x:Bind ViewModel.SettingsDownloadBpsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Transfer memory bytes"
                         Text="{x:Bind ViewModel.SettingsTransferMemoryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Range cache bytes"
                         Text="{x:Bind ViewModel.SettingsRangeCacheText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Staging admission bytes"
                         Text="{x:Bind ViewModel.SettingsStagingAdmissionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Minimum free bytes"
                         Text="{x:Bind ViewModel.SettingsMinimumFreeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Reload settings" Command="{x:Bind ViewModel.ReloadSettingsCommand}" />
                    <Button Content="Apply settings" Command="{x:Bind ViewModel.ApplySettingsCommand}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.SettingsRevisionText, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.SettingsResultText, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind ViewModel.SettingsErrorText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <!-- Connection controls -->
            <StackPanel Spacing="8">
                <TextBlock Text="Connection controls" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="Connection ID (UUID; leave empty for Pause/Resume to cover every connection)"
                         Text="{x:Bind ViewModel.ConnectionIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Optional item ID (subtree target for Pin/Unpin and Free Space)"
                         Text="{x:Bind ViewModel.ControlItemIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Pause" Command="{x:Bind ViewModel.PauseCommand}" />
                    <Button Content="Resume" Command="{x:Bind ViewModel.ResumeCommand}" />
                    <Button Content="Pin" Command="{x:Bind ViewModel.PinCommand}" />
                    <Button Content="Unpin" Command="{x:Bind ViewModel.UnpinCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Free all local space" Command="{x:Bind ViewModel.FreeAllCommand}" />
                    <Button Content="Free all except pinned" Command="{x:Bind ViewModel.FreeExceptPinnedCommand}" />
                </StackPanel>
                <TextBox Header="Selective-sync exclusions (complete item UUIDs, comma-separated)"
                         Text="{x:Bind ViewModel.SelectiveSyncItemIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Apply selective sync" Command="{x:Bind ViewModel.ApplySelectiveSyncCommand}" />
                <TextBlock Text="{x:Bind ViewModel.ConnectionResultText, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind ViewModel.ConnectionErrorText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <!-- Diagnostics -->
            <StackPanel Spacing="8">
                <TextBlock Text="Diagnostics" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="Absolute destination path for the diagnostics ZIP"
                         Text="{x:Bind ViewModel.DiagnosticsPathText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Export diagnostics" Command="{x:Bind ViewModel.ExportDiagnosticsCommand}" />
                <TextBlock Text="{x:Bind ViewModel.DiagnosticsResultText, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind ViewModel.DiagnosticsErrorText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <!-- History and restore -->
            <StackPanel Spacing="8">
                <TextBlock Text="History" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="Optional subtree item ID (history filter)"
                         Text="{x:Bind ViewModel.HistoryItemIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Load history" Command="{x:Bind ViewModel.LoadHistoryCommand}" />
                    <Button Content="Load more" Command="{x:Bind ViewModel.LoadMoreHistoryCommand}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.HistoryResultText, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <ListView ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryRow">
                            <TextBlock Text="{x:Bind Display, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       IsTextSelectionEnabled="True"
                                       Margin="0,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Restore" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <TextBox Header="Item ID to restore (UUID)"
                         Text="{x:Bind ViewModel.RestoreItemIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="Version ID to restore (UUID)"
                         Text="{x:Bind ViewModel.RestoreVersionIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Restore" Command="{x:Bind ViewModel.RestoreCommand}" />
                <TextBlock Text="{x:Bind ViewModel.HistoryErrorText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <!-- Conflicts -->
            <StackPanel Spacing="8">
                <TextBlock Text="Conflicts" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Load conflicts" Command="{x:Bind ViewModel.LoadConflictsCommand}" />
                    <Button Content="Load more" Command="{x:Bind ViewModel.LoadMoreConflictsCommand}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ConflictsResultText, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <ListView ItemsSource="{x:Bind ViewModel.Conflicts, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedConflict, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConflictRow">
                            <TextBlock Text="{x:Bind Display, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Bind ViewModel.SelectedConflictDetailText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="12"
                           IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Keep local" Command="{x:Bind ViewModel.ResolveKeepLocalCommand}" />
                    <Button Content="Keep remote" Command="{x:Bind ViewModel.ResolveKeepRemoteCommand}" />
                    <Button Content="Keep both" Command="{x:Bind ViewModel.ResolveKeepBothCommand}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ConflictsErrorText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
