<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RootNamespace>HfDrive.Protocol.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HfDrive.Protocol\HfDrive.Protocol.csproj" />
  </ItemGroup>

  <!--
    Compile the tray's real readiness and issue-projection logic into the
    protocol tests so these regressions exercise the same source the tray
    ships. The files depend only on the protocol DTOs, so no UI reference is
    introduced.
  -->
  <ItemGroup>
    <Compile Include="..\HfDrive.Desktop\ViewModels\TraySyncReadiness.cs" Link="TraySyncReadiness.cs" />
    <Compile Include="..\HfDrive.Desktop\ViewModels\TrayIssueProjection.cs" Link="TrayIssueProjection.cs" />
    <Compile Include="..\HfDrive.Desktop\ViewModels\SettingsQuantity.cs" Link="SettingsQuantity.cs" />
  </ItemGroup>

</Project>
